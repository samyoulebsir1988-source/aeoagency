# Google Apps Script web app URL (the /exec URL, deployed as Anyone).
# Required for the free audit form. See README.md for the setup steps.
AUDIT_WEBHOOK_URL=

# Optional. Canonical origin used for metadata, Open Graph, and the sitemap.
# Example: https://www.example.com
# If unset on Vercel, the production domain is used instead.
NEXT_PUBLIC_SITE_URL=
